<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- For re-signing the bundled Node (resources/node/bin/node) with a Developer ID before notarization
       (.github/workflows/desktop.yml): the official binary's entitlements minus get-task-allow, which
       notarization rejects. V8 needs JIT; sharp's .node addon and libvips are separately signed dylibs. -->
  <key>com.apple.security.cs.allow-jit</key><true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key><true/>
  <key>com.apple.security.cs.disable-library-validation</key><true/>
</dict>
</plist>
