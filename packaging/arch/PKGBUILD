# Maintainer: Wooangha <https://github.com/Wooangha>
#
# Arch Linux package made from the release .deb (the one CI builds and smoke-tests, DESIGN §19): the files keep
# the deb's paths, which the app relies on (/usr/bin/easy-study, the bundled Node as /usr/bin/es-node beside it,
# its resources in /usr/lib/easy-study/{node,server}).
#
# The .deb comes from the release repository (installers and updates; the source is Wooangha/easy-study): `makepkg -si` next
# to this file downloads it and checks its sha256 (a .deb already next to it is used instead).
# CI (.github/workflows/desktop.yml, job arch-x64) sets pkgver from package.json and the checksums of the build's
# own .deb files, then builds, installs and smoke-tests the package on current Arch Linux; a release gets that
# PKGBUILD and the x86_64 package (desktop/scripts/publish-release.mjs checks that it points here). After a release,
# copy its PKGBUILD here (or bump pkgver, reset pkgrel=1 and run `updpkgsums` from pacman-contrib), then run
# `makepkg --printsrcinfo > .SRCINFO`.

pkgname=easy-study-bin
_pkgname=easy-study
pkgver=0.5.2
pkgrel=1
pkgdesc='Study lecture PDFs slide by slide with an LLM tutor (Claude Code, Codex, Claude API, OpenAI API): desktop app'
arch=('x86_64' 'aarch64')
url='https://github.com/Wooangha/easy-study-releases'
# The bundled Node.js and third-party (PDFium…) notices are linked into /usr/share/licenses below.
license=('MIT')
# What the app (WebKitGTK shell, native-tls → libssl) and the bundled Node (libatomic, libstdc++) link against.
# gcc-libs: libatomic/libgcc/libstdc++ (split out of it on current Arch, where it pulls them in).
# gst-plugins-base/-good: WebKitGTK's microphone capture (lecture recording) and WAV/Opus playback.
depends=('cairo' 'dbus' 'gcc-libs' 'gdk-pixbuf2' 'glib2' 'glibc' 'gtk3' 'hicolor-icon-theme' 'libsoup3' 'openssl'
         'webkit2gtk-4.1' 'gst-plugins-base' 'gst-plugins-good')
optdepends=('noto-fonts-cjk: Korean (CJK) text in the app window'
            'gst-libav: play uploaded lecture recordings (AAC/m4a) in the app'
            'noto-fonts-emoji: color emoji'
            'xdg-utils: open links and the library folder in the default applications')
provides=("$_pkgname")
conflicts=("$_pkgname")
# Prebuilt binaries: the official Node.js runtime and sharp/libvips are used as shipped.
options=('!strip' '!debug')
source_x86_64=("${_pkgname}_${pkgver}_amd64.deb::$url/releases/download/v$pkgver/${_pkgname}_${pkgver}_amd64.deb")
source_aarch64=("${_pkgname}_${pkgver}_arm64.deb::$url/releases/download/v$pkgver/${_pkgname}_${pkgver}_arm64.deb")
sha256sums_x86_64=('e9633c646be9ce6a562edf0adf87ff0712c7c0a57cac4a28168f8cb12572d2d4')
sha256sums_aarch64=('eadd048c209c59cc1f367d541fecb9ef4840a6aecb4026a65a34e51c6e86b744')

package() {
  # makepkg has already unpacked the .deb (debian-binary, control.tar.*, data.tar.*) into $srcdir.
  bsdtar -xf data.tar.* -C "$pkgdir"

  # Up to 0.2.1, Tauri put the 256 px icon (128x128@2x.png) in hicolor/256x256@2, the folder for 512 px images.
  local icons="$pkgdir/usr/share/icons/hicolor"
  if [[ -d $icons/256x256@2 && ! -e $icons/256x256 ]]; then
    mv "$icons/256x256@2" "$icons/256x256"
  fi

  install -dm755 "$pkgdir/usr/share/licenses/$pkgname"
  ln -s "/usr/lib/$_pkgname/node/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/node-LICENSE"
  ln -s "/usr/lib/$_pkgname/server/THIRD_PARTY_NOTICES.md" "$pkgdir/usr/share/licenses/$pkgname/THIRD_PARTY_NOTICES.md"
  # The MIT license of easy-study itself ships in the server folder from 0.5.3 on.
  if [[ -e "$pkgdir/usr/lib/$_pkgname/server/LICENSE" ]]; then
    ln -s "/usr/lib/$_pkgname/server/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  fi
}
