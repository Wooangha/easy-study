{
  "name": "easy-study",
  "version": "0.1.0",
  "private": true,
  "description": "Study lecture PDFs slide-by-slide with Claude Code / Codex / Claude API / OpenAI API",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node --watch-path=server --watch-path=shared server/index.ts --dev",
    "build": "vite build --config web/vite.config.ts && node scripts/build-server.mjs",
    "build:server": "node scripts/build-server.mjs",
    "start": "npm run build && node --max-semi-space-size=2 dist-server/server/index.js",
    "serve": "node --max-semi-space-size=2 dist-server/server/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "test": "node --test tests/*.test.ts web/tests/*.test.ts",
    "sample": "uv run --with reportlab --with pillow python scripts/make_sample_pdf.py samples/sample-lecture.pdf"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "express": "^5.2.1",
    "openai": "^7.22.0",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "highlight.js": "^11.12.0",
    "katex": "^0.18.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
